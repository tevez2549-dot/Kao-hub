-- เรียกใช้ Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- สร้างหน้าต่าง UI
local Window = Rayfield:CreateWindow({
   Name = "Kao Hub",
   LoadingTitle = "กำลังโหลด Kao Hub...",
   LoadingSubtitle = "by Your Name",
   ConfigurationSaving = {
      Enabled = false,
   },
   Discord = {
      Enabled = false,
   },
   KeySystem = false,
})

-- สร้างแท็บเมนู
local Tab = Window:CreateTab("Main", 4483362458) 

-- ตัวแปรสำหรับควบคุมการเปิด/ปิด
getgenv().autoPencil = false
getgenv().autoChair = false
getgenv().autoSellMuscle = false
getgenv().autoClick = false
getgenv().highJump = false
getgenv().jumpPower = 100 
getgenv().walkSpeed = false
getgenv().speedValue = 16

-- ==========================================
-- ปุ่ม Toggle สำหรับ Pencil
-- ==========================================
Tab:CreateToggle({
   Name = "เปิดใช้งาน Pencil (Auto)",
   CurrentValue = false,
   Flag = "PencilToggle", 
   Callback = function(Value)
        getgenv().autoPencil = Value
        
        if Value then
            task.spawn(function()
                while getgenv().autoPencil do
                    task.wait(0.1) 
                    
                    pcall(function()
                        local player = game:GetService("Players").LocalPlayer
                        local character = player.Character
                        
                        if character and character:FindFirstChild("Pencil") then
                            local pencil = character:FindFirstChild("Pencil")
                            if pencil:FindFirstChild("Script") and pencil.Script:FindFirstChild("RemoteEvent") then
                                local args = { 6 }
                                pencil.Script.RemoteEvent:FireServer(unpack(args))
                            end
                        end
                    end)
                end
            end)
        end
   end,
})

