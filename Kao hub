})

-- ==========================================
-- ปุ่ม Toggle สำหรับ Auto Click (แก้ไขบัคเดินไม่ได้แล้ว)
-- ==========================================
Tab:CreateToggle({
   Name = "Auto Click (คลิกเมาส์รัวๆ)",
   CurrentValue = false,
   Flag = "AutoClickToggle", 
   Callback = function(Value)
        getgenv().autoClick = Value
        local vim = game:GetService("VirtualInputManager")
        
        if Value then
            task.spawn(function()
                while getgenv().autoClick do
                    task.wait(0.05) 
                    pcall(function()
                        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)  
                        task.wait(0.01)
                        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0) 
                    end)
                end
            end)
        else
            -- บังคับปล่อยคลิกทันทีเมื่อปิด เพื่อแก้ปัญหาเดินไม่ได้
            pcall(function()
                vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
   end,
})

-- ==========================================
-- ส่วนควบคุม: วิ่งไว (WalkSpeed)
-- ==========================================
Tab:CreateToggle({
   Name = "เปิดใช้งาน วิ่งไว",
   CurrentValue = false,
   Flag = "WalkSpeedToggle", 
   Callback = function(Value)
        getgenv().walkSpeed = Value
        
        task.spawn(function()
            while getgenv().walkSpeed do
                task.wait(0.1)
                pcall(function()
                    local player = game:GetService("Players").LocalPlayer
                    if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                        humanoid.WalkSpeed = getgenv().speedValue
                    end
                end)
            end
            
            -- รีเซ็ตค่าความเร็วกลับเป็นปกติเมื่อปิดใช้งาน
            pcall(function()
                local player = game:GetService("Players").LocalPlayer
                if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    humanoid.WalkSpeed = 16 -- ค่ามาตรฐาน Roblox
                end
            end)
        end)
   end,
})

Tab:CreateSlider({
   Name = "ปรับความเร็วในการวิ่ง",
   Range = {16, 300},
   Increment = 5,
   Suffix = " Speed",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
      getgenv().speedValue = Value
   end,
})

-- ==========================================
-- ส่วนควบคุม: กระโดดสูง (High Jump)
-- ==========================================
Tab:CreateToggle({
   Name = "เปิดใช้งาน กระโดดสูง",
   CurrentValue = false,
   Flag = "HighJumpToggle", 
   Callback = function(Value)
        getgenv().highJump = Value
        
        task.spawn(function()
            while getgenv().highJump do
                task.wait(0.1)
                pcall(function()
                    local player = game:GetService("Players").LocalPlayer
                    if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                        humanoid.UseJumpPower = true
                        humanoid.JumpPower = getgenv().jumpPower
                    end
                end)
            end
            
            pcall(function()
                local player = game:GetService("Players").LocalPlayer
                if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    humanoid.JumpPower = 50 
                end
            end)
        end)
   end,
})

Tab:CreateSlider({
   Name = "ปรับระดับความสูงของการกระโดด",
   Range = {50, 500},
   Increment = 10,
   Suffix = " Power",
   CurrentValue = 100,
   Flag = "JumpSlider",
   Callback = function(Value)
      getgenv().jumpPower = Value
   end,
})

