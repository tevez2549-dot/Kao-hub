-- ==========================================
-- ปุ่ม Toggle สำหรับ SellMuscle (Auto)
-- ==========================================
Tab:CreateToggle({
   Name = "เปิดใช้งาน SellMuscle (Auto)",
   CurrentValue = false,
   Flag = "SellMuscleToggle", 
   Callback = function(Value)
        getgenv().autoSellMuscle = Value
        
        if Value then
            task.spawn(function()
                while getgenv().autoSellMuscle do
                    task.wait(0.1) 
                    
